import { Palette } from "std-widgets.slint";

export struct MonitorRow {
    id: string,
    name: string,
    brightness: int,
    can-control: bool,
    pending: bool,
    message: string,
}

component BrightnessSlider inherits Rectangle {
    in-out property <float> value: 0;
    in property <bool> enabled: true;
    callback released(float);

    height: 32px;
    opacity: root.enabled ? 1 : 0.55;

    private property <length> thumb-size: 20px;
    private property <length> usable-width: max(0px, root.width - root.thumb-size);
    private property <length> thumb-x: root.usable-width * clamp(root.value, 0, 100) / 100;
    private property <bool> dragging: false;
    private property <length> drag-offset: root.thumb-size / 2;

    rail := Rectangle {
        x: root.thumb-size / 2;
        y: (root.height - 4px) / 2;
        width: root.usable-width;
        height: 4px;
        border-radius: 2px;
        background: Palette.border;
    }

    fill := Rectangle {
        x: rail.x;
        y: rail.y;
        width: root.thumb-x;
        height: rail.height;
        border-radius: rail.border-radius;
        background: root.enabled ? Palette.accent-background : Palette.accent-background.with-alpha(0.35);
    }

    thumb := Rectangle {
        x: root.thumb-x;
        y: (root.height - self.width) / 2;
        width: root.thumb-size;
        height: self.width;
        border-radius: self.width / 2;
        background: Palette.alternate-background;
        border-width: 1px;
        border-color: focus-scope.has-focus ? Palette.border : Palette.border.with-alpha(0.16);

        inner := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.dragging || focus-scope.has-focus ? 10px : touch.has-hover ? 14px : 12px;
            height: self.width;
            border-radius: self.width / 2;
            background: !root.enabled ? Palette.accent-background.with-alpha(0.35)
                : root.dragging ? Palette.accent-background.with-alpha(0.8)
                : touch.has-hover ? Palette.accent-background.with-alpha(0.9)
                : Palette.accent-background;
            animate width, background { duration: 150ms; }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.dragging = true;
                focus-scope.focus();
                // Keep the grab point under the cursor; a track click centers the thumb.
                root.drag-offset = self.mouse-x >= root.thumb-x && self.mouse-x <= root.thumb-x + root.thumb-size
                    ? self.mouse-x - root.thumb-x
                    : root.thumb-size / 2;
                root.drag-to(self.mouse-x);
            } else if (event.kind == PointerEventKind.up) {
                if (root.dragging) {
                    root.dragging = false;
                    root.released(root.value);
                }
            }
        }
        moved => {
            if (root.dragging) {
                root.drag-to(self.mouse-x);
            }
        }
    }

    focus-scope := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.set-value(root.value + 1);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.set-value(root.value - 1);
                return accept;
            }
            if (event.text == Key.Home) {
                root.set-value(0);
                return accept;
            }
            if (event.text == Key.End) {
                root.set-value(100);
                return accept;
            }
            reject
        }
        key-released(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow
                || event.text == Key.LeftArrow || event.text == Key.DownArrow
                || event.text == Key.Home || event.text == Key.End) {
                root.released(root.value);
                return accept;
            }
            reject
        }
    }

    pure function value-from-x(x: length) -> float {
        clamp((x - root.thumb-size / 2) * 100 / max(root.usable-width, 1px), 0, 100)
    }

    function drag-to(x: length) {
        root.set-value(root.value-from-x(x - root.drag-offset + root.thumb-size / 2));
    }

    function set-value(value: float) {
        let clamped = clamp(value, 0, 100);
        if (clamped != root.value) {
            root.value = clamped;
        }
    }
}

component MonitorControl inherits Rectangle {
    in property <MonitorRow> monitor;
    in property <bool> busy;
    callback set-brightness(string, int);
    private property <int> model-brightness: root.monitor.brightness;
    private property <float> preview-brightness: root.monitor.brightness;
    // A drag updates the preview through the two-way binding below; model updates
    // must be pushed back into the preview once the committed value is known.
    changed model-brightness => { root.preview-brightness = root.model-brightness; }
    height: root.monitor.can-control ? 96px : 144px;
    background: transparent;

    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 12px;
        spacing: 12px;
        alignment: start;
        HorizontalLayout {
            height: 24px;
            spacing: 12px;
            Text { text: root.monitor.name; overflow: elide; color: Palette.foreground; horizontal-stretch: 1; vertical-alignment: center; }
            Text { text: root.monitor.can-control ? round(root.preview-brightness) + "%" : "—"; min-width: 48px; horizontal-alignment: right; vertical-alignment: center; color: Palette.foreground; }
        }
        brightness-slider := BrightnessSlider {
            value <=> root.preview-brightness;
            enabled: root.monitor.can-control && !root.busy;
            // Dragging only updates the preview; commit one DDC/CI write on release.
            released(value) => { root.set-brightness(root.monitor.id, round(value)); }
        }
        if !root.monitor.can-control: Text {
            text: root.monitor.message;
            font-size: 12px;
            color: Palette.foreground;
            opacity: 0.75;
            wrap: word-wrap;
        }
    }
}

export component QuickPanel inherits Window {
    title: "GlimTray · 亮度面板";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 360px;
    preferred-height: 128px;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    forward-focus: keys;

    in property <[MonitorRow]> monitors;
    in property <bool> busy: true;
    in property <string> status: "正在检测显示器…";
    callback refresh();
    callback set-brightness(string, int);
    callback drain-updates();
    callback dismiss();

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); return accept; }
            return reject;
        }
        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 8px;
            VerticalLayout {
                padding: 16px;
                if root.monitors.length > 0: VerticalLayout {
                    for monitor in root.monitors: MonitorControl {
                        monitor: monitor;
                        busy: root.busy;
                        set-brightness(id, percent) => { root.set-brightness(id, percent); }
                    }
                }
                if root.monitors.length == 0: Text {
                    text: root.status;
                    color: Palette.foreground;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    in property <bool> dark-taskbar: false;
    in property <bool> startup-enabled: false;
    in property <bool> startup-available: false;
    in property <string> startup-error;
    callback set-startup(bool);
    icon: root.dark-taskbar ? @image-url("../assets/icons/tray-on-dark.png") : @image-url("../assets/icons/tray-on-light.png");
    tooltip: root.startup-error != "" ? "GlimTray · " + root.startup-error : "GlimTray · 显示器亮度";
    callback toggle-panel();
    callback quit();
    clicked => { root.toggle-panel(); }
    Menu {
        MenuItem {
            title: !root.startup-available ? "开机自启（不可用）" : root.startup-enabled ? "关闭开机自启" : "开启开机自启";
            enabled: root.startup-available;
            activated => { root.set-startup(!root.startup-enabled); }
        }
        MenuSeparator {}
        MenuItem { title: "退出"; activated => { root.quit(); } }
    }
}
