import { ListView, Palette, Slider } from "std-widgets.slint";

export struct MonitorRow {
    id: string,
    name: string,
    brightness: int,
    can-control: bool,
    pending: bool,
    message: string,
}

component MonitorControl inherits Rectangle {
    in property <MonitorRow> monitor;
    in property <bool> busy;
    callback set-brightness(string, int);
    private property <int> model-brightness: root.monitor.brightness;
    private property <int> preview-brightness: root.monitor.brightness;
    // Slider interaction replaces its value binding; apply later model updates explicitly.
    // A drag previews locally, so the model may still hold the last committed value.
    changed model-brightness => {
        root.preview-brightness = root.model-brightness;
        brightness-slider.value = root.model-brightness;
    }
    height: root.monitor.can-control ? 96px : 144px;
    background: transparent;

    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 12px;
        spacing: 12px;
        alignment: start;
        HorizontalLayout {
            height: 24px;
            spacing: 12px;
            Text { text: root.monitor.name; overflow: elide; color: Palette.foreground; horizontal-stretch: 1; vertical-alignment: center; }
            Text { text: root.monitor.can-control ? root.preview-brightness + "%" : "—"; min-width: 48px; horizontal-alignment: right; vertical-alignment: center; color: Palette.foreground; }
        }
        brightness-slider := Slider {
            height: 32px;
            minimum: 0;
            maximum: 100;
            value: root.monitor.brightness;
            enabled: root.monitor.can-control && !root.busy;
            // Dragging only updates the local preview; commit one DDC/CI write on release.
            changed(value) => { root.preview-brightness = round(value); }
            released(value) => { root.set-brightness(root.monitor.id, round(value)); }
        }
        if !root.monitor.can-control: Text {
            text: root.monitor.message;
            font-size: 12px;
            color: Palette.foreground;
            opacity: 0.75;
            wrap: word-wrap;
        }
    }
}

export component QuickPanel inherits Window {
    title: "GlimTray · 亮度面板";
    icon: @image-url("../assets/icons/glimtray.png");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 360px;
    preferred-height: 128px;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    forward-focus: keys;

    in property <[MonitorRow]> monitors;
    in property <bool> busy: true;
    in property <string> status: "正在检测显示器…";
    callback refresh();
    callback set-brightness(string, int);
    callback drain-updates();
    callback dismiss();

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); return accept; }
            return reject;
        }
        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 8px;
            VerticalLayout {
                padding: 16px;
                if root.monitors.length > 0: ListView {
                    for monitor in root.monitors: MonitorControl {
                        monitor: monitor;
                        busy: root.busy;
                        set-brightness(id, percent) => { root.set-brightness(id, percent); }
                    }
                }
                if root.monitors.length == 0: Text {
                    text: root.status;
                    color: Palette.foreground;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    in property <bool> dark-taskbar: false;
    in property <bool> startup-enabled: false;
    in property <bool> startup-available: false;
    in property <string> startup-error;
    callback set-startup(bool);
    icon: root.dark-taskbar ? @image-url("../assets/icons/tray-on-dark.png") : @image-url("../assets/icons/tray-on-light.png");
    tooltip: root.startup-error != "" ? "GlimTray · " + root.startup-error : "GlimTray · 显示器亮度";
    callback toggle-panel();
    callback quit();
    clicked => { root.toggle-panel(); }
    Menu {
        MenuItem {
            title: !root.startup-available ? "开机自启（不可用）" : root.startup-enabled ? "关闭开机自启" : "开启开机自启";
            enabled: root.startup-available;
            activated => { root.set-startup(!root.startup-enabled); }
        }
        MenuSeparator {}
        MenuItem { title: "退出"; activated => { root.quit(); } }
    }
}
