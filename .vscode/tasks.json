{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--locked"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "cargo: build release",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build-release.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "cargo: run",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--locked"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: check",
      "type": "process",
      "command": "cargo",
      "args": ["check", "--locked"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: clippy",
      "type": "process",
      "command": "cargo",
      "args": ["clippy", "--locked", "--all-targets", "--no-deps", "--", "-D", "warnings"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: fmt",
      "type": "process",
      "command": "cargo",
      "args": ["fmt", "--package", "glimtray"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
